VisualElement {
}

.stats-root {
    flex-grow: 1;
    background-color: rgb(50, 54, 132);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.stats-title {
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.stats-scroll {
    flex-grow: 1;
    margin-bottom: 12px;
}

.stats-empty {
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.stats-back-button {
    height: 80px;
    font-size: 32px;
}

.statistics-group-header {
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}

.statistics-row {
    color: rgb(255, 255, 255);
    font-size: 24px;
    white-space: normal;
    margin-bottom: 4px;
}
