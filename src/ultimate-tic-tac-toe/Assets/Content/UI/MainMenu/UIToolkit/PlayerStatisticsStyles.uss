VisualElement {
}

.stats-root {
    flex-grow: 1;
    background-color: rgb(50, 54, 132);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.stats-title {
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.stats-scroll {
    flex-grow: 1;
    margin-bottom: 12px;
}

.stats-empty {
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.stats-back-button {
    height: 64px;
    font-size: 28px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.9);
}

.stats-back-button:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.stats-back-button:active {
    background-color: rgba(255, 255, 255, 0.22);
}

.statistics-group-header {
    color: rgba(100, 200, 120, 0.92);
    font-size: 30px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}

.statistics-row {
    color: rgba(255, 255, 255, 0.82);
    font-size: 24px;
    white-space: normal;
    margin-bottom: 4px;
}
