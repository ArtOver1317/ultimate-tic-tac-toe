VisualElement {
}

.menu-root {
    flex-grow: 1;
    opacity: 1;
    background-color: rgb(50, 54, 132);
    justify-content: center;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
}

.menu-title {
    color: rgb(255, 255, 255);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 90%;
    margin-bottom: 40px;
}

.menu-button {
    width: 320px;
    max-width: 80%;
    height: 110px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-width: 0;
    background-image: url("project://database/Assets/2D%20Casual%20UI/Sprite/GUI.png?fileID=21300036&guid=1eaee135ce037439d925cee5e41ce026&type=3#GUI_18");
    background-color: rgba(255, 255, 255, 0);
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    font-size: 44px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.menu-button:disabled {
    opacity: 1;
    background-image: url("project://database/Assets/2D%20Casual%20UI/Sprite/GUI.png?fileID=21300036&guid=1eaee135ce037439d925cee5e41ce026&type=3#GUI_18");
    background-color: rgba(255, 255, 255, 0);
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1);
    color: rgba(255, 255, 255, 0.9);
}
