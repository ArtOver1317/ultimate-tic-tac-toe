<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PlayerStatisticsStyles.uss" />
    <ui:VisualElement name="Root" class="stats-root">
        <ui:Label text="..." name="Title" class="stats-title" />
        <ui:ScrollView name="GroupsContainer" class="stats-scroll" />
        <ui:Label text="..." name="EmptyStateLabel" class="stats-empty" />
        <ui:Button text="..." name="BackButton" class="stats-back-button" />
    </ui:VisualElement>
</ui:UXML>
