.gameplay-field-root {
    --cell-size-min: 24px;
    --grid-gap: 5;
    --grid-gap-half: 3;
    --mini-board-gap: 12px;
    --mini-board-gap-half: 6;
    --mini-board-padding: 5;
    --border-color: rgba(255, 255, 255, 0.22);
    --cell-bg: rgba(255, 255, 255, 0.10);
    --border-width: 1px;
    --border-radius: 7px;
    --cell-border-color: var(--border-color);
    --cell-radius: var(--border-radius);
    --mini-board-radius: 12px;
    --mini-board-border-width: 2;
    --mini-board-border-color: rgba(255, 255, 255, 0.40);
    --mini-board-bg: rgba(255, 255, 255, 0.04);

    --anim-fast-ms: 160ms;
    --anim-ease: ease-out;

     /* Phase 4: mark font size derives from runtime cell size.
         Scale is a design token read by presenter: fontSizePx = cellSizePx * --mark-font-scale */
     --mark-font-scale: 0.62;

     --mark-color-x: rgba(210, 80, 80, 0.82);
     --mark-color-o: rgba(70, 190, 175, 0.85);

    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
}

.gameplay-toolbar {
    width: 100%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 4px;
}

.back-button {
    width: 120px;
    height: 44px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 20px;
}

/* === Scoreboard === */
.scoreboard {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 8px;
    padding: 6px 0;
}

.player-panel {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.05);
    transition-property: background-color, border-color;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

.player-panel--active {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(100, 200, 120, 0.75);
}

.player-name {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.85);
    margin-right: 12px;
    -unity-font-style: bold;
}

.player-score {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    min-width: 28px;
    -unity-text-align: middle-center;
}

.current-player-label {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 16px;
    -unity-text-align: middle-center;
}

.move-timer-label {
    min-width: 54px;
    margin-right: 12px;
    -unity-text-align: middle-center;
}

.move-timer-label.move-timer-label--warning {
    color: rgba(255, 255, 255, 0.85);
}

.field-container {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-content: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.field-container.field-container--round-finished {
    opacity: 0.94;
}

.field-container--ultimate {
}

.field-container--battleship {
    justify-content: flex-start;
    align-items: center;
}

.battleship-boards {
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
}

.battleship-board {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 12px 8px 12px;
}

.battleship-board-title {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.86);
    -unity-font-style: bold;
    margin-bottom: 4px;
    transition-property: color;
    transition-duration: 200ms;
    transition-timing-function: ease;
}

/* === Battleship turn indicators === */

.battleship-board--active-attack .battleship-board-grid {
    border-color: rgba(255, 220, 55, 0.90);
    border-width: 2px;
    border-radius: 2px;
}

.battleship-board--active-attack .battleship-board-title {
    color: rgba(255, 230, 65, 1);
}

.battleship-board--under-attack .battleship-board-grid {
    border-color: rgba(255, 80, 80, 0.60);
    border-width: 2px;
    border-radius: 2px;
}

.battleship-board--under-attack .battleship-board-title {
    color: rgba(255, 140, 140, 0.90);
}

.battleship-board-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.battleship-board .cell {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

.battleship-board--own .cell {
    background-color: rgba(255, 255, 255, 0.16);
}

/* === Battleship opponent board hit/sunk cell states === */

.battleship-board--opponent .cell.battleship-opponent--hit {
    background-color: rgba(200, 50, 50, 0.85);
    border-color: rgba(240, 100, 100, 0.80);
}

.battleship-board--opponent .cell.battleship-opponent--sunk {
    background-color: rgba(120, 15, 15, 0.95);
    border-color: rgba(200, 60, 60, 0.85);
}

/* === Battleship own board battle states (specificity 0,3,0 beats base 0,2,0) === */

.battleship-board--own .cell.battleship-own--ship {
    background-color: rgba(55, 95, 170, 0.65);
    border-color: rgba(100, 140, 220, 0.55);
}

.battleship-board--own .cell.battleship-own--ship:hover {
    background-color: rgba(65, 110, 190, 0.72);
}

.battleship-board--own .cell.battleship-own--hit {
    background-color: rgba(200, 50, 50, 0.85);
    border-color: rgba(240, 100, 100, 0.80);
}

.battleship-board--own .cell.battleship-own--sunk {
    background-color: rgba(120, 15, 15, 0.95);
    border-color: rgba(200, 60, 60, 0.85);
}

.cell-mark #OwnMarkLabel.battleship-own--hit {
    color: rgba(255, 230, 230, 1);
    -unity-font-style: bold;
    font-size: 20px;
}

.cell-mark #OwnMarkLabel.battleship-own--sunk {
    color: rgba(255, 200, 200, 1);
    -unity-font-style: bold;
    font-size: 20px;
}

/* === Battleship placement ship state === */

.cell.placement-ship--placed {
    background-color: rgba(70, 120, 200, 0.75);
    border-color: rgba(120, 170, 255, 0.9);
    border-width: 1px;
}

.cell.placement-ship--selected {
    background-color: rgba(50, 180, 110, 0.80);
    border-color: rgba(100, 220, 150, 0.95);
    border-width: 1px;
}

.cell.placement-ship--hover {
    background-color: rgba(240, 210, 40, 0.82);
    border-color: rgba(255, 235, 80, 1);
    border-width: 2px;
}

/* Overrides native :hover when mouse is directly on the anchor cell */
.cell:hover.placement-ship--hover {
    background-color: rgba(240, 210, 40, 0.82);
    border-color: rgba(255, 235, 80, 1);
    border-width: 2px;
}

.placement-ready-button {
    background-color: rgba(45, 150, 65, 0.88);
    border-color: rgba(80, 200, 105, 0.9);
    border-width: 2px;
    color: rgba(255, 255, 255, 1);
    padding-left: 14px;
    padding-right: 14px;
    -unity-font-style: bold;
}

.placement-status-label {
    font-size: 13px;
    color: rgba(255, 245, 195, 0.92);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.field-row,
.mini-row,
.mini-row-inner {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
}

.mini-board {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    position: relative;
    padding: var(--mini-board-padding);
    border-color: var(--mini-board-border-color);
    border-width: var(--mini-board-border-width);
    border-radius: var(--mini-board-radius);
    background-color: var(--mini-board-bg);
    margin: var(--mini-board-gap-half);
    transition-property: background-color, border-color;
    transition-duration: var(--anim-fast-ms);
    transition-timing-function: var(--anim-ease);
}

.cell {
    min-width: var(--cell-size-min);
    min-height: var(--cell-size-min);
    background-color: var(--cell-bg);
    border-color: var(--cell-border-color);
    border-width: var(--border-width);
    border-radius: var(--cell-radius);
    margin: var(--grid-gap-half);
    transition-property: background-color, border-color;
    transition-duration: var(--anim-fast-ms);
    transition-timing-function: var(--anim-ease);
}

.cell.cell--disabled {
    /* Visual hint only; interactivity is enforced from C# (SetEnabled + pickingMode). */
    opacity: 0.92;
}

.cell:hover {
    background-color: rgba(255, 255, 255, 0.13);
    border-color: rgba(255, 255, 255, 0.30);
}

.cell-mark {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;

    /* Phase 4: mark appear VFX (scale + fade) via design-token transitions. */
    transition-property: opacity, scale;
    transition-duration: var(--anim-fast-ms);
    transition-timing-function: var(--anim-ease);
}

.cell-mark #MarkLabel {
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
}

.cell-mark #OwnMarkLabel {
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
}

.cell-mark #MarkLabel.mark-label--x {
    color: var(--mark-color-x);
}

.cell-mark #MarkLabel.mark-label--o {
    color: var(--mark-color-o);
}

.cell-mark #MarkLabel.battleship-mark--ship,
.cell-mark #OwnMarkLabel.battleship-mark--ship {
    color: rgba(255, 255, 255, 0.82);
}

.cell-mark #MarkLabel.battleship-mark--miss,
.cell-mark #OwnMarkLabel.battleship-mark--miss {
    color: rgba(230, 248, 255, 1);
    font-size: 36px;
}

.cell-mark #MarkLabel.battleship-mark--hit,
.cell-mark #OwnMarkLabel.battleship-mark--hit {
    color: rgba(255, 230, 230, 1);
    -unity-font-style: bold;
    font-size: 20px;
}

.cell-mark #MarkLabel.battleship-mark--sunk,
.cell-mark #OwnMarkLabel.battleship-mark--sunk {
    color: rgba(255, 210, 210, 1);
    -unity-font-style: bold;
    font-size: 20px;
}

.cell-mark.cell-mark--appearFrom {
    opacity: 0;
    scale: 0.85;
}

/* States (prepared for gameplay rules) */
.mini-board.miniBoard--active,
.mini-board.mini-board--active {
    border-color: rgba(255, 255, 255, 0.72);
    background-color: rgba(255, 255, 255, 0.07);
}

.mini-board.mini-board--allowed {
    border-color: rgba(100, 200, 120, 0.85);
    background-color: rgba(100, 200, 120, 0.10);
}

.mini-board.mini-board--closed {
    background-color: rgba(255, 255, 255, 0.10);
}

.cell.cell--allowed {
    background-color: rgba(255, 255, 255, 0.17);
    border-color: rgba(255, 255, 255, 0.34);
}

.cell.cell--lastMove {
    background-color: rgba(255, 255, 255, 0.23);
    border-color: rgba(255, 255, 255, 0.52);
}

.mini-board.miniBoard--wonX,
.mini-board.miniBoard--wonO,
.mini-board.miniBoard--draw,
.mini-board.mini-board--wonX,
.mini-board.mini-board--wonO,
.mini-board.mini-board--draw,
.mini-board.mini-board--won-x,
.mini-board.mini-board--won-o {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.55);
}

.mini-board.mini-board--won-x {
    border-color: var(--mark-color-x);
}

.mini-board.mini-board--won-o {
    border-color: var(--mark-color-o);
}

/* Won overlays: tinted dark background hides underlying marks; text stays white for contrast. */
.mini-board.mini-board--won-x .mini-board-status-overlay {
    background-color: rgba(50, 12, 12, 0.80);
}

.mini-board.mini-board--won-o .mini-board-status-overlay {
    background-color: rgba(8, 45, 45, 0.80);
}

.mini-board-status-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.96);
    font-size: 86px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.34);
    border-radius: var(--mini-board-radius);
}

.mini-board.mini-board--closed .mini-board-status-overlay,
.mini-board.mini-board--draw .mini-board-status-overlay {
    background-color: rgba(0, 0, 0, 0.42);
}

/* === Win Line Overlay === */
.win-line {
    position: absolute;
    background-color: rgba(220, 50, 50, 0.80);
    border-radius: 3px;
    transform-origin: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.win-line--visible {
    opacity: 1;
}

/* === Result Popup Overlay === */
.result-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.result-popup {
    width: 340px;
    padding: 28px 24px;
    border-radius: 16px;
    background-color: rgba(30, 30, 30, 0.95);
    border-color: rgba(255, 255, 255, 0.18);
    border-width: 1px;
    align-items: center;
}

.result-label {
    font-size: 28px;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.score-label {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.72);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.lead-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.result-buttons {
    flex-direction: row;
    justify-content: center;
}

.result-button {
    width: 120px;
    height: 48px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.12);
    color: white;
    font-size: 20px;
    margin: 0 8px;
}

.result-button:hover {
    background-color: rgba(255, 255, 255, 0.20);
}
