.gmw-mode-settings {
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
}

.gmw-mode-settings__label {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 6px;
}

.gmw-stepper {
    flex-direction: row;
    align-items: center;
}

.gmw-stepper__button {
    width: 56px;
    height: 56px;
    font-size: 28px;
    background-color: rgba(255, 255, 255, 0.08);
}

.gmw-stepper__value {
    min-width: 60px;
    text-align: center;
    font-size: 26px;
    color: rgb(255, 255, 255);
    margin-left: 12px;
    margin-right: 12px;
}
