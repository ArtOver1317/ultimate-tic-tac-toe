<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:app="Runtime.UI.Components" xmlns:wizard="Runtime.UI.GameModes.Wizard" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="MatchSetupStyles.uss" />
    <Style src="WizardErrorOverlayStyles.uss" />
    <ui:VisualElement name="Root" class="gmw-root">
        <ui:VisualElement name="Header" class="gmw-header">
            <ui:Button text="" name="BackButton" class="gmw-button gmw-button--back" />
            <ui:Label text="" name="TitleLabel" class="gmw-title" />
        </ui:VisualElement>

        <ui:ScrollView name="MainScroll" class="gmw-content-scroll" mode="Vertical">
            <ui:VisualElement name="Content" class="gmw-content">
                <ui:VisualElement name="ModeOptionsSection" class="gmw-section">
                    <ui:Label text="" name="ModeOptionsTitle" class="gmw-section__title" />
                    <app:ModeOptionsHost name="ModeOptionsHost" class="gmw-mode-options-host" />
                </ui:VisualElement>

                <ui:VisualElement name="MoveTimerSection" class="gmw-section gmw-move-timer-settings">
                    <ui:Label text="" name="MoveTimerTitle" class="gmw-section__title" />
                    <app:DifficultyChips name="MoveTimerChips" class="gmw-difficulty-chips gmw-move-timer-chips" />
                </ui:VisualElement>

                <ui:VisualElement name="OpponentSection" class="gmw-section">
                    <ui:Label text="" name="OpponentTitle" class="gmw-section__title" />
                    <app:SegmentedToggle name="OpponentToggle" class="gmw-segmented-toggle" />
                </ui:VisualElement>

                <ui:VisualElement name="BotSettingsSection" class="gmw-section gmw-bot-settings">
                    <ui:Label text="" name="BotSettingsTitle" class="gmw-section__title" />
                    <app:DifficultyChips name="DifficultyChips" class="gmw-difficulty-chips" />
                </ui:VisualElement>

                <ui:VisualElement name="HumanSettingsSection" class="gmw-section gmw-human-settings">
                    <ui:Label text="" name="HumanSettingsTitle" class="gmw-section__title" />
                    <wizard:HumanKindRadio name="HumanKindRadio" class="gmw-human-kind-radio" />
                    <app:PlayerIdInput name="PlayerIdInput" class="gmw-player-id-input" />
                    <ui:VisualElement name="OnlinePanel" class="gmw-online-panel">
                        <ui:VisualElement class="gmw-online-panel__row">
                            <ui:Label text="" name="SessionIdLabel" class="gmw-online-panel__label" />
                            <ui:Label text="" name="SessionIdValue" class="gmw-online-panel__value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="gmw-online-panel__actions">
                            <ui:Button text="" name="BecomeHostButton" class="gmw-button gmw-button--secondary gmw-online-panel__button" />
                            <ui:Button text="" name="CopySessionIdButton" class="gmw-button gmw-button--secondary gmw-online-panel__button" />
                        </ui:VisualElement>
                        <ui:Label text="" name="OnlineStatusLabel" class="gmw-online-panel__status" />
                        <ui:Label text="" name="OnlineCountdownLabel" class="gmw-online-panel__countdown" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="ActionBar" class="gmw-action-bar">
                    <ui:Button text="" name="CancelButton" class="gmw-button gmw-button--secondary" />
                    <ui:Button text="" name="StartButton" class="gmw-button gmw-button--primary" />
                </ui:VisualElement>

                <ui:Label text="" name="ErrorLabel" class="gmw-error-label" />
            </ui:VisualElement>
        </ui:ScrollView>

        <app:WizardErrorOverlay name="ErrorOverlay" class="gmw-error-overlay" />
    </ui:VisualElement>
</ui:UXML>
