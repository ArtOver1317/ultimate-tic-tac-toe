.gmw-root {
    flex-grow: 1;
    background-color: rgb(50, 54, 132);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
    position: relative;
}

.gmw-title {
    font-size: 40px;
    color: rgb(255, 255, 255);
}

.gmw-action-bar {
    margin-top: 20px;
    height: 110px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
}

.gmw-button {
    width: 240px;
    height: 72px;
    font-size: 32px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.gmw-button--primary {
    background-color: rgba(255, 255, 255, 0.12);
}

.gmw-button--secondary {
    background-color: rgba(255, 255, 255, 0.05);
}

.gmw-matchmaking-root {
    justify-content: flex-start;
}

.gmw-matchmaking-state {
    margin-top: 20px;
    align-items: center;
    justify-content: center;
}

.gmw-matchmaking-spinner {
    margin-top: 24px;
    margin-bottom: 16px;
}

.matchmaking-spinner {
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    background-image: url("../../../Common/LoadingIcon.png");
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    background-position: center;
}

@keyframes matchmaking-glyph-pulse {
    0%   { opacity: 1.0; scale: 1.0; }
    50%  { opacity: 0.5; scale: 0.88; }
    100% { opacity: 1.0; scale: 1.0; }
}

.matchmaking-spinner__glyph {
    -unity-text-align: middle-center;
    font-size: 42px;
    color: rgba(255, 255, 255, 0.95);
    -unity-font-style: bold;
    animation-name: matchmaking-glyph-pulse;
    animation-duration: 1000ms;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
}

.matchmaking-timer {
    align-items: center;
    justify-content: center;
}

.matchmaking-timer__label {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
}

.gmw-matchmaking-status {
    font-size: 32px;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 12px;
}

.gmw-error-label {
    margin-top: 8px;
    color: rgb(255, 140, 140);
    font-size: 20px;
    display: none;
}

.gmw-matchmaking-hint {
    margin-top: 12px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    display: none;
}

.gmw-matchmaking-state--found,
.gmw-matchmaking-state--failed,
.gmw-matchmaking-state--cancelled {
    display: none;
}

