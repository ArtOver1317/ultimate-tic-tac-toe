.gmw-root {
    flex-grow: 1;
    background-color: rgb(50, 54, 132);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.gmw-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 90px;
}

.gmw-title {
    font-size: 40px;
    color: rgb(255, 255, 255);
    margin-left: 16px;
}

.gmw-section {
    margin-top: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.gmw-section__title {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 8px;
}

.gmw-mode-options-host {
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    padding-left: 12px;
    padding-right: 12px;
}

.gmw-action-bar {
    margin-top: 20px;
    height: 110px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
}

.gmw-button {
    width: 240px;
    height: 72px;
    font-size: 32px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.gmw-button--primary {
    background-color: rgba(255, 255, 255, 0.12);
}

.gmw-button--secondary {
    background-color: rgba(255, 255, 255, 0.05);
}

.gmw-button--back {
    width: 140px;
    height: 60px;
    font-size: 26px;
    background-color: rgba(255, 255, 255, 0.05);
}

.gmw-error-label {
    margin-top: 8px;
    color: rgb(255, 140, 140);
    font-size: 20px;
    display: none;
}

.gmw-segmented-toggle {
    flex-direction: row;
}

.segmented-toggle {
    flex-direction: row;
    width: 100%;
}

.segmented-toggle__button {
    flex-grow: 1;
    height: 64px;
    font-size: 28px;
    background-color: rgba(255, 255, 255, 0.04);
}

.segmented-toggle__button--selected {
    background-color: rgba(255, 255, 255, 0.18);
}
