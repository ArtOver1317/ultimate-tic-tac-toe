.gmw-root {
    flex-grow: 1;
    background-color: rgb(50, 54, 132);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
    position: relative;
    flex-direction: column;
}

.gmw-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 90px;
    flex-shrink: 0;
}

.gmw-content-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.gmw-content {
    flex-direction: column;
    padding-bottom: 12px;
}

.gmw-title {
    font-size: 40px;
    color: rgb(255, 255, 255);
    margin-left: 16px;
}

.gmw-section {
    margin-top: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-shrink: 0;
}

.gmw-section__title {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 8px;
}

.gmw-mode-options-host {
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    padding-left: 12px;
    padding-right: 12px;
}

.gmw-action-bar {
    margin-top: 16px;
    height: 96px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    flex-shrink: 0;
}

.gmw-button {
    width: 240px;
    height: 64px;
    font-size: 28px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    flex-shrink: 0;
}

.gmw-button--primary {
    background-color: rgba(255, 255, 255, 0.12);
}

.gmw-button--secondary {
    background-color: rgba(255, 255, 255, 0.05);
}

.gmw-button--back {
    width: 140px;
    height: 54px;
    font-size: 24px;
    background-color: rgba(255, 255, 255, 0.05);
}

.gmw-error-label {
    margin-top: 8px;
    color: rgb(255, 140, 140);
    font-size: 20px;
    display: none;
}

.gmw-segmented-toggle {
    flex-direction: row;
}

.gmw-bot-settings {
    margin-top: 12px;
}

.gmw-human-settings {
    margin-top: 12px;
    width: 100%;
}

.gmw-difficulty-chips {
    flex-direction: row;
}

.gmw-move-timer-settings {
    margin-top: 12px;
}

.gmw-move-timer-chips {
    flex-direction: row;
}

.difficulty-chips {
    flex-direction: row;
    width: 100%;
}

.difficulty-chips__item {
    flex-grow: 1;
    height: 64px;
    font-size: 28px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    margin-right: 12px;
}

.difficulty-chips__item--last {
    margin-right: 0;
}

.difficulty-chips__item--selected {
    background-color: rgba(255, 255, 255, 0.18);
}

.segmented-toggle {
    flex-direction: row;
    width: 100%;
}

.segmented-toggle__button {
    flex-grow: 1;
    height: 64px;
    font-size: 28px;
    background-color: rgba(255, 255, 255, 0.04);
    flex-shrink: 0;
}

.segmented-toggle__button--selected {
    background-color: rgba(255, 255, 255, 0.18);
}

.gmw-human-kind-radio {
    flex-direction: column;
}

.gmw-player-id-input {
    margin-top: 12px;
    width: 100%;
}

.gmw-online-panel {
    margin-top: 10px;
    padding: 10px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    display: none;
    width: 100%;
    flex-shrink: 0;
}

.gmw-online-panel__row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
}

.gmw-online-panel__label {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.85);
}

.gmw-online-panel__value {
    font-size: 22px;
    color: rgb(255, 255, 255);
    margin-left: 10px;
}

.gmw-online-panel__actions {
    flex-direction: row;
    margin-top: 10px;
    width: 100%;
    justify-content: space-between;
    flex-shrink: 0;
}

.gmw-online-panel__button {
    width: 49%;
    height: 54px;
    font-size: 22px;
    min-height: 54px;
    flex-shrink: 0;
}

.gmw-online-panel__status {
    margin-top: 10px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.9);
}

.gmw-online-panel__countdown {
    margin-top: 4px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.95);
}

.human-kind-radio {
    flex-direction: column;
    width: 100%;
}

.human-kind-radio__item {
    height: 64px;
    font-size: 28px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.human-kind-radio__item--last {
    margin-bottom: 0;
}

.human-kind-radio__item--selected {
    background-color: rgba(255, 255, 255, 0.18);
}

.human-kind-radio__item--disabled {
    opacity: 0.55;
}

.player-id-input {
    flex-direction: column;
    width: 100%;
}

.player-id-input__label {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 6px;
}

.player-id-input__field {
    height: 60px;
    font-size: 24px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    min-height: 60px;
    flex-shrink: 0;
}


.player-id-input__error {
    margin-top: 6px;
    color: rgb(255, 140, 140);
    font-size: 18px;
    display: none;
}
